<Project Sdk="Microsoft.NET.Sdk">
  <!-- 윈도우 앱 (트레이 아이콘 + 창들). 맥에서도 컴파일만은 된다 (EnableWindowsTargeting). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(FGTarget)-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>FocusGuard</AssemblyName>
    <RootNamespace>FocusGuard.App</RootNamespace>
    <ApplicationIcon>tomato.ico</ApplicationIcon>
    <Product>Focus Guard</Product>
    <Company>Anonymous, KAIST IS</Company>
    <!-- 배포: 실행 파일 하나 (런타임 포함, 설치 필요 없음) -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="tomato.ico" LogicalName="tomato.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FocusGuard.Core/FocusGuard.Core.csproj" />
  </ItemGroup>
</Project>
