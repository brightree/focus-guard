<Project>
  <!-- 공통 설정. 기본은 .NET 10 (LTS). 이 맥처럼 오래된 SDK 에서 시험할 땐 -p:FGTarget=net7.0 -->
  <PropertyGroup>
    <FGTarget Condition="'$(FGTarget)' == ''">net10.0</FGTarget>
    <LangVersion>11</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- 버전은 맥 앱과 같은 app/VERSION 하나에서 -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../app/VERSION').Trim())</Version>
  </PropertyGroup>
</Project>
